params {
    reads          = "data/*_R{1,2}.fastq.gz"
    ref            = "reference/chr7_slice.fa"
    outdir         = "results"

    // QC thresholds — used by scripts/parse_vcf_qc.py to compute pass/fail
    min_mean_depth      = 20
    min_q30_pct         = 90.0
    titv_min            = 1.9
    titv_max            = 2.3
    min_variant_pass_pct = 90.0
    max_dup_rate_pct    = 20.0
}

process {
    executor = 'local'
    cpus     = 2
}

report {
    enabled   = true
    file      = "${params.outdir}/nextflow_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/nextflow_timeline.html"
    overwrite = true
}
